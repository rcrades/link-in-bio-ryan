{
  "version": 2,
  "buildCommand": "vite build",
  "devCommand": "vite",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "start-with-v0.ryanrademann.com" }],
      "destination": "/pages/start-with-v0/index.html"
    },
    { "source": "/pages/:path*", "destination": "/pages/:path*" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
} 